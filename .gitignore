# Dependencies and build output (node_modules without a slash: in a worktree it is a link to the repository's)
node_modules
out/
dist/

# Playwright Test's results and report (npm test, test:e2e; the CI keeps them as artifacts)
test-results/
playwright-report/

# The developer's own: their environment (direnv), their IDE's settings (JetBrains)
.envrc
.idea/

# Development worktrees
.worktrees/

# Claude Code: personal settings and its worktrees stay local; the skill entrypoints (.claude/skills), the settings and the
# development plugins (.claude/dev-plugins) are shared
.claude/settings.local.json
.claude/worktrees/
