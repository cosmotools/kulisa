{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2024", "DOM"],
    "strict": true, "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "types": ["vite/client"]
  },
  "include": ["*.tsx"]
}
