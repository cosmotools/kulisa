{
  "name": "kulisa-dev",
  "version": "1.0.0",
  "description": "Code intelligence for developing Kulisa: TypeScript through the project's own language server",
  "author": {
    "name": "Kulisa"
  },
  "lspServers": {
    "typescript": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/node_modules/typescript-language-server/lib/cli.mjs",
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".mts": "typescript",
        ".tsx": "typescriptreact",
        ".cjs": "javascript",
        ".mjs": "javascript"
      },
      "initializationOptions": {
        "tsserver": {
          "useSyntaxServer": "never"
        }
      }
    }
  }
}
