{
  "enabledPlugins": {
    "kulisa-dev@kulisa-dev": true
  },
  "extraKnownMarketplaces": {
    "kulisa-dev": {
      "source": {
        "source": "directory",
        "path": "./.claude/dev-plugins"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.ts\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
