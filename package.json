  "scripts": {
    "start": "vite build --logLevel warn && node scripts/electron.ts .",
    "build": "tsc -p . && tsc -p test && vue-tsc --noEmit -p src/renderer && vite build --logLevel warn",
    "watch": "vite build --watch",
    "test": "node test/start.ts",
    "test:visible": "node test/start.ts --visible",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "knip": "knip",
    "lint": "eslint . && npm run deps",
    "deps": "depcruise src",
    "postinstall": "electron-rebuild -f -w node-pty",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "icons": "node scripts/icons.ts"
  },
  "main": "src/main/index.ts",
  "author": "Orudzhali Nagaev",
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.4": true
  }
