    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "colorthief": "^3.5.0",
    "dockview-vue": "^8.4.0",
    "electron-squirrel-startup": "^1.0.1",
