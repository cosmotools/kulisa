// The tests: as strict as the code (tsconfig.json), but for null: a test counts on what it checks being there (the task
// shown, a profile by its id), and when it is not, the test fails, which is what it is for.
{
  "extends": "../tsconfig.json",
  "compilerOptions": { "strictNullChecks": false },
  "include": ["."]
}
