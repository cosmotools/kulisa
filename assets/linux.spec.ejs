# Kulisa's RPM layout; docs/releases.md, Installers.
%define _binary_payload w<%= compressionLevel %>.xzdio

%if "%{_host_cpu}" != "%{_target_cpu}"
%global __strip /bin/true
%endif

Name: <%= name %>
Version: <%= version %>
Release: <%= revision %>%{?dist}
Summary: <%= description %>
License: <%= license %>
URL: <%= homepage %>
Requires: <%= requires.join(', ') %>
AutoReqProv: no

%description
<%= productDescription %>

%install
mkdir -p "%{buildroot}/usr/"
cp -a "%{_topdir}/BUILD/usr/." "%{buildroot}/usr/"

%files
%defattr(-,root,root,-)
/usr/bin/<%= name %>
/usr/lib/<%= name %>/
/usr/share/applications/<%= name %>.desktop
/usr/share/doc/<%= name %>/
/usr/share/pixmaps/<%= name %>.png
