// knip: files, exports and dependencies nothing uses (npm run knip; npm test runs it first). Its plugins find most
// entry points themselves (package.json's main and scripts, Vite with Vue, node --test); listed here are those loaded
// by a path instead of an import. docs/testing.md, "Dead code".
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // The windows' preload, loaded by its path (window.js, master.js).
    "src/preload/index.cjs",
    // The master window's and Settings' pages, vite.config.mts's other inputs: knip finds them there on Linux, not on
    // Windows (the CI's first runs, 2026-10-12). On Linux knip hints they are redundant: keep them, Windows needs them.
    "src/renderer/master.ts",
    "src/renderer/settings.ts",
    // The e2e groups, which run.js requires by name (start.js → run.js --files=…).
    "test/*.ts",
    "!test/helpers.ts",
    // The debug-kulisa skill's script, run by its path; Claude Code's hooks (.claude/settings.json).
    ".claude/skills/debug-kulisa/*.mjs",
    ".claude/hooks/*.ts",
    // dependency-cruiser's rules, which it finds by their name (npm run deps).
    ".dependency-cruiser.ts"
  ],
  // direnv: the user's own, which tasks use when it is installed (worktrees.ts); the tests check it the same way.
  // actionlint: the developer's own, npm test runs it when installed (docs/testing.md, Workflows).
  "ignoreBinaries": ["direnv", "actionlint"],
  // Forge's makers, publisher and plugins, named by strings in forge.config.ts. The language server and its Vue plugin,
  // run by Claude Code's kulisa-dev plugin (.claude/dev-plugins; README, Developing with Claude Code).
  "ignoreDependencies": ["@electron-forge/maker-.*", "@electron-forge/publisher-github", "@electron-forge/plugin-auto-unpack-natives",
    "typescript-language-server", "@vue/typescript-plugin"]
}
